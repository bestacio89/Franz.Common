<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../sources/Franz.Common/Franz.Common.csproj" />
    <ProjectReference Include="../../sources/Franz.Common.Errors/Franz.Common.Errors.csproj" />
    <ProjectReference Include="../../sources/Franz.Common.Reflection/Franz.Common.Reflection.csproj" />
    <ProjectReference Include="../../sources/Franz.Common.Mapping/Franz.Common.Mapping.csproj" />
    <ProjectReference Include="../../sources/Franz.Common.Mediator/Franz.Common.Mediator.csproj" />
    <ProjectReference
      Include="../../sources/Microsoft.Common.Mediator.SourceGenerator/Franz.Common.Mediator.SourceGenerator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;TrimMode" />
    <Analyzer Include="../../sources/Franz.Common.Mapping.Generators/bin/Release/netstandard2.0/Franz.Common.Mapping.Generators.dll" />
  </ItemGroup>
</Project>
