<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Franz.Common">
      <HintPath>../../sources/Franz.Common/bin/Release/net10.0/Franz.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Franz.Common.Errors">
      <HintPath>../../sources/Franz.Common.Errors/bin/Release/net10.0/Franz.Common.Errors.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Franz.Common.Reflection">
      <HintPath>../../sources/Franz.Common.Reflection/bin/Release/net10.0/Franz.Common.Reflection.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Franz.Common.Mapping">
      <HintPath>../../sources/Franz.Common.Mapping/bin/Release/net10.0/Franz.Common.Mapping.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Analyzer Include="../../sources/Franz.Common.Mapping.Generators/bin/Release/netstandard2.0/Franz.Common.Mapping.Generators.dll" />
  </ItemGroup>
</Project>
