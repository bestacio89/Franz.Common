<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageReference Include="Testcontainers.Redis" Version="4.16.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../sources/Franz.Common.Caching/Franz.Common.Caching.csproj" AdditionalProperties="EnablePackageValidation=false" />
  </ItemGroup>
</Project>
