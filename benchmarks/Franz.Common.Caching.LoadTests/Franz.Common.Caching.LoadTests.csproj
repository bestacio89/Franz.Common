<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageReference Include="NBomber" Version="6.6.0" />
    <PackageReference Include="MessagePack" Version="2.5.303" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.13.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../sources/Franz.Common.Caching/Franz.Common.Caching.csproj" />
  </ItemGroup>
</Project>
