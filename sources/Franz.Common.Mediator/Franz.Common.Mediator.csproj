<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.targets" />

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Franz.Common\Franz.Common.csproj" />
    <ProjectReference
      Include="..\Microsoft.Common.Mediator.SourceGenerator\Franz.Common.Mediator.SourceGenerator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the generator as a compiler analyzer with the mediator package so
       downstream projects receive generated module registrations transitively. -->
  <Target Name="IncludeMediatorSourceGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\Microsoft.Common.Mediator.SourceGenerator\bin\$(Configuration)\netstandard2.0\Franz.Common.Mediator.SourceGenerator.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
